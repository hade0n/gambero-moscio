ILENIA_PASSWORD=
SALVATORE_PASSWORD=

# Persistenza — Supabase (server-side, mai nel bundle client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Opzionale: abilita le foto reali dei locali nella Ruota del Gambero
# (Google Places API). Senza chiave la card usa un placeholder.
GOOGLE_MAPS_API_KEY=

# Solo per l'export una-tantum dei dati dal vecchio archivio Vercel Blob
# (npm run export:blob). Si può rimuovere a migrazione completata.
BLOB_READ_WRITE_TOKEN=
